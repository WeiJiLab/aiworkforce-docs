---
import IconButton from "../../../components/IconButton.astro";
import { editorCopy } from "../../../lib/automation-editor";

export function getStaticPaths() {
  return [
    { params: { locale: undefined }, props: { locale: "zh-CN" as const } },
    { params: { locale: "en" }, props: { locale: "en" as const } },
  ];
}
const { locale } = Astro.props;
const copy = editorCopy[locale];
---

<!doctype html>
<html lang={locale}>
  <head
    ><meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><title>{copy.title}</title></head
  >
  <body>
    <main>
      <form id="editor">
        <header>
          <div class="crumb">
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><rect x="2" y="3" width="6" height="6" rx="1.5"></rect><rect
                x="16"
                y="15"
                width="6"
                height="6"
                rx="1.5"></rect><path d="M5 9v5a4 4 0 0 0 4 4h7M8 6h6"
              ></path></svg
            >{copy.automations}
            <span>/</span>
            {copy.newJob}
          </div>
          <div class="actions">
            <small>{copy.local}</small><IconButton
              type="submit"
              label={copy.run}
              ><svg viewBox="0 0 24 24" aria-hidden="true"
                ><path d="m7 4 13 8-13 8z"></path></svg
              ></IconButton
            >
          </div>
        </header>
        <div class="sheet">
          <input
            class="name"
            aria-label={copy.jobLabel}
            name="job"
            value={copy.job}
            maxlength="64"
            required
          />
          <p class="subtitle">{copy.subtitle}</p>
          <div class="meta">
            <span class="draft">{copy.draft}</span><span>Loop V2 Test</span
            ><select name="employee" aria-label={copy.employee}
              ><option>{copy.developer}</option><option>{copy.qa}</option
              ></select
            >
          </div>
          <div class="columns">
            <section aria-label={copy.definition}>
              <h2>{copy.trigger}</h2>
              <div class="rule">
                <div class="rule-row">
                  <svg viewBox="0 0 24 24" aria-hidden="true"
                    ><circle cx="6" cy="5" r="2.5"></circle><circle
                      cx="6"
                      cy="19"
                      r="2.5"></circle><circle cx="18" cy="6" r="2.5"
                    ></circle><path d="M6 8v8m0-3h5a7 7 0 0 0 7-5"></path></svg
                  ><select name="event" aria-label={copy.event}
                    ><option value="opened">{copy.opened}</option><option
                      value="closed">{copy.closed}</option
                    ></select
                  ><span>{copy.inRepo}</span><code>demo/product</code>
                </div>
                <label class="rule-row"
                  >{copy.label}<select name="tag" aria-label={copy.label}
                    ><option value="any">{copy.any}</option><option>bug</option
                    ><option>enhancement</option></select
                  ></label
                >
              </div>
              <div class="defaults">
                <span>Skill<strong>{copy.none}</strong></span><span
                  >{copy.model}<strong>{copy.inherit}</strong></span
                ><span
                  >{copy.reasoning}<strong>{copy.defaultValue}</strong></span
                >
              </div>
              <label class="task"
                >{copy.task}<textarea
                  name="task"
                  rows="2"
                  maxlength="600"
                  required>{copy.instructions}</textarea
                ></label
              >
            </section>
            <aside>
              <h2>{copy.configuration}</h2><dl>
                {
                  copy.settings.map(([label, value]) => (
                    <div>
                      <>
                        <dt>{label}</dt>
                        <dd>{value}</dd>
                      </>
                    </div>
                  ))
                }
              </dl>
            </aside>
          </div>
        </div>
        <footer>
          <div class="sample">
            <span class="mark" aria-hidden="true">◎</span><b>{copy.sample}</b
            ><code>#128</code><span>{copy.issueOpened}</span><span class="tag"
              >bug</span
            >
          </div>
          <output aria-live="polite" id="result">{copy.hint}</output>
        </footer>
      </form>
    </main>
    <script define:vars={{ messages: copy.result }}>
      const editor = document.querySelector("#editor");
      const result = document.querySelector("#result");
      const hint = result.textContent;
      const frame = window.frameElement;
      if (frame) {
        const main = document.querySelector("main");
        new ResizeObserver(() => {
          frame.style.height = `${Math.ceil(main.getBoundingClientRect().height)}px`;
        }).observe(main);
      }
      editor.addEventListener("input", () => {
        result.textContent = hint;
        delete result.dataset.state;
      });
      editor.addEventListener("submit", (event) => {
        event.preventDefault();
        const data = new FormData(editor);
        const mismatches = [];
        if (data.get("event") !== "opened") mismatches.push(messages.event);
        if (!["bug", "any"].includes(data.get("tag")))
          mismatches.push(messages.label);
        result.dataset.state = mismatches.length ? "skipped" : "matched";
        if (mismatches.length) {
          result.textContent = messages.skipped.replace(
            "{reasons}",
            mismatches.join(messages.join),
          );
        } else {
          result.textContent = messages.matched.replace(
            /\{(job|employee|task)\}/g,
            (_, field) => data.get(field),
          );
        }
      });
    </script>
  </body>
</html>
<style is:inline>
  * {
    box-sizing: border-box;
  }
  :root {
    color-scheme: light;
    font-family:
      Inter,
      -apple-system,
      BlinkMacSystemFont,
      "PingFang SC",
      "Microsoft YaHei",
      sans-serif;
    color: #233644;
    background: #edf3f5;
    font-size: 14px;
  }
  body {
    margin: 0;
  }
  main {
    max-width: 1120px;
    margin: 0 auto;
    padding: clamp(8px, 2.4vw, 28px);
  }
  form {
    background: white;
    border: 1px solid #bdcfd5;
    border-radius: 14px;
    box-shadow: 0 5px 16px #2449580c;
  }
  header,
  .sheet,
  footer {
    padding: 16px clamp(14px, 3vw, 32px);
  }
  header,
  .crumb,
  .actions,
  .meta,
  .rule-row,
  .sample {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  header {
    justify-content: space-between;
    border-bottom: 1px solid #dae4e8;
    padding-block: 10px;
  }
  .crumb {
    font-weight: 600;
  }
  .crumb span,
  small,
  .subtitle,
  dt {
    color: #576b79;
  }
  small {
    font-size: 12px;
  }
  svg {
    width: 18px;
    height: 18px;
    stroke: currentColor;
    stroke-width: 1.65;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
    flex: none;
  }
  .crumb svg,
  .mark {
    color: #137769;
  }
  .docs-icon-button {
    position: relative;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: #e0f3ec;
    border: 1px solid #a4d5c5;
    color: #096955;
    cursor: pointer;
  }
  .docs-icon-button:hover {
    background: #cfecdf;
  }
  .docs-tooltip {
    position: absolute;
    z-index: 1;
    right: 0;
    top: calc(100% + 4px);
    padding: 5px 8px;
    white-space: nowrap;
    font-size: 12px;
    border-radius: 5px;
    background: #223641;
    color: white;
    visibility: hidden;
  }
  .docs-icon-button:is(:focus-visible, :hover) .docs-tooltip {
    visibility: visible;
  }
  :is(select, input, textarea, button):focus-visible {
    outline: 2px solid #16816f;
    outline-offset: 2px;
  }
  input,
  select,
  textarea {
    font: inherit;
    color: inherit;
  }
  .name {
    width: 100%;
    padding: 2px 0;
    border: 0;
    font-weight: 650;
    font-size: clamp(22px, 3vw, 30px);
  }
  .subtitle {
    margin: 4px 0 12px;
  }
  .meta {
    gap: 12px;
    flex-wrap: wrap;
    font-size: 13px;
  }
  .draft {
    border-right: 1px solid #d2dde0;
    padding-right: 12px;
  }
  .draft::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    background: #899da6;
    border-radius: 50%;
    margin-right: 6px;
  }
  select {
    background-color: #edf6f7;
    border: 1px solid #d5e4e6;
    border-radius: 6px;
    padding: 5px;
    cursor: pointer;
  }
  .columns {
    display: grid;
    grid-template-columns: minmax(0, 2.35fr) minmax(155px, 1fr);
    gap: clamp(12px, 3vw, 30px);
    margin-top: 19px;
  }
  h2,
  .task {
    font-size: 14px;
    font-weight: 650;
    margin: 0 0 9px;
  }
  .rule {
    padding: 12px;
    border: 1px solid #cfdde2;
    border-radius: 9px;
  }
  .rule-row {
    flex-wrap: wrap;
    gap: 7px;
    font-size: 13px;
  }
  .rule-row + .rule-row {
    margin-top: 9px;
  }
  code {
    font:
      12px ui-monospace,
      monospace;
  }
  .rule code {
    padding: 6px 8px;
    background: #eef4f6;
    border-radius: 5px;
  }
  .defaults {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    margin: 15px 0;
    color: #516570;
    font-size: 12px;
  }
  .defaults strong {
    display: block;
    margin-top: 5px;
    font-size: 13px;
    font-weight: 450;
    color: #293d49;
  }
  .task,
  textarea {
    display: block;
    width: 100%;
  }
  textarea {
    border: 1px solid #cfdde2;
    border-radius: 8px;
    margin: 7px 0 0;
    padding: 9px 11px;
    line-height: 1.65;
    font-weight: 400;
    resize: vertical;
  }
  aside {
    border-left: 1px solid #d8e3e6;
    padding-left: clamp(12px, 2.6vw, 25px);
  }
  dl {
    margin: 0;
    font-size: 13px;
  }
  dl div {
    display: flex;
    justify-content: space-between;
    gap: 6px;
    padding: 6px 0;
  }
  dl div:nth-child(2) {
    border-bottom: 1px solid #e0e9eb;
    padding-bottom: 10px;
    margin-bottom: 4px;
  }
  dd {
    margin: 0;
  }
  footer {
    border-top: 1px solid #cfdfdc;
    background: #f2f8f6;
    border-radius: 0 0 14px 14px;
  }
  .sample {
    flex-wrap: wrap;
    gap: 7px;
    font-size: 13px;
  }
  .mark {
    font-size: 19px;
  }
  .tag {
    background: #dcf0e7;
    color: #22604d;
    border-radius: 8px;
    padding: 1px 7px;
  }
  output {
    display: block;
    margin-top: 5px;
    line-height: 1.6;
    font-size: 13px;
    overflow-wrap: anywhere;
    color: #51646c;
  }
  output[data-state="matched"] {
    color: #11624d;
  }
  output[data-state="skipped"] {
    color: #805920;
  }
  @media (max-width: 580px) {
    .columns {
      grid-template-columns: 1fr;
    }
    aside {
      border: 0;
      border-top: 1px solid #dae4e8;
      padding: 12px 0 0;
    }
    dl {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3px 14px;
    }
    dl div,
    dl div:nth-child(2) {
      border: 0;
      padding: 3px 0;
      margin: 0;
    }
  }
  @media (max-width: 380px) {
    dl {
      font-size: 12px;
    }
    .meta {
      gap: 8px;
    }
  }
</style>
