---
import "../styles/custom.css";
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <title>Page not found · AI Workforce Docs</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <main>
      <a class="brand" href="/">AI Workforce <span>Docs</span></a>
      <p class="code">404</p>
      <h1>This page could not be found.</h1>
      <p lang="zh-CN">没有找到这个页面。请回到「开始使用」。</p>
      <nav aria-label="Documentation home">
        <a href="/">English documentation →</a><a href="/zh-cn/" lang="zh-CN"
          >简体中文文档 →</a
        >
      </nav>
    </main>
  </body>
</html>
<style>
  body {
    margin: 0;
    color: var(--docs-ink);
    background: var(--sl-color-gray-7);
    font-family: var(--sl-font);
  }
  main {
    max-width: 40rem;
    margin: 12vh auto;
    padding: 2rem;
  }
  a {
    color: var(--docs-accent);
    text-decoration: none;
  }
  .brand {
    font-size: 1rem;
    font-weight: 650;
    color: var(--docs-ink);
  }
  .brand span {
    color: var(--docs-muted);
    font-weight: 400;
    margin-left: 0.5rem;
  }
  .code {
    margin-top: 5rem;
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    color: var(--docs-accent);
  }
  h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    letter-spacing: -0.04em;
    line-height: 1.2;
  }
  p {
    color: var(--docs-muted);
    line-height: 1.8;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin-top: 2rem;
  }
</style>
