---
import SidebarPersister from "@astrojs/starlight/components/SidebarPersister.astro";
import SidebarSublist from "@astrojs/starlight/components/SidebarSublist.astro";

import { externalNav, getPortal, portalDestinations } from "../lib/navigation";

const { entry, locale, sidebar } = Astro.locals.starlightRoute;
const zh = locale === "zh-cn";
const portal = getPortal(entry.id);
const destinations = portalDestinations(locale);
const outbound = externalNav(locale);
const directoryIndex = sidebar.findIndex(
  (entry) =>
    entry.type === "group" &&
    entry.entries.some(
      (child) =>
        child.type === "link" && child.href.endsWith("/integrations/overview/"),
    ),
);
const directory = sidebar[directoryIndex];
---

<div class="portal-sidebar" data-portal={portal}>
  <div class="portal-directory">
    <nav
      class="portal-navigation"
      data-portal={portal}
      data-site="workforce"
      aria-label={zh ? "当前栏目目录" : "Current section navigation"}
    >
      <SidebarPersister>
        {
          directory?.type === "group" ? (
            <>
              <SidebarSublist sublist={sidebar.slice(0, directoryIndex)} />
              <section
                class="integration-directory"
                aria-labelledby="integration-directory-title"
              >
                <h2 id="integration-directory-title">{directory.label}</h2>
                <SidebarSublist
                  nested
                  sublist={directory.entries.filter(
                    (entry) => entry.type === "link",
                  )}
                />
                {directory.entries.map(
                  (category) =>
                    category.type === "group" && (
                      <>
                        <h3>{category.label}</h3>
                        <SidebarSublist nested sublist={category.entries} />
                      </>
                    ),
                )}
              </section>
              <SidebarSublist sublist={sidebar.slice(directoryIndex + 1)} />
            </>
          ) : (
            <SidebarSublist sublist={sidebar} />
          )
        }
      </SidebarPersister>
    </nav>
  </div>
  <div class="portal-sidebar-footer">
    <nav
      class="portal-destinations site-nav-mobile"
      aria-label={zh ? "切换栏目" : "Switch section"}
    >
      {
        destinations.map((destination) => (
          <a
            class="portal-link"
            href={destination.href}
            data-portal-target={destination.id}
            data-active={destination.id === portal ? "true" : undefined}
          >
            <span>{destination.label}</span>
            {destination.id === portal && (
              <span class="portal-current" aria-hidden="true" />
            )}
          </a>
        ))
      }
      {
        outbound.map((item) => (
          <a
            class="portal-link"
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>{item.label}</span>
          </a>
        ))
      }
    </nav>
  </div>
</div>

<style>
  .integration-directory {
    margin-block: 0.75rem;
  }
  .integration-directory h2 {
    padding: 0.25rem 0.5rem;
    color: var(--docs-ink);
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .integration-directory h3 {
    margin-block: 0.625rem 0.125rem;
    padding-inline: 0.5rem;
    color: var(--docs-muted);
    font-size: 0.75rem;
    font-weight: 600;
  }
</style>
