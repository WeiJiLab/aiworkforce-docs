---
import SidebarPersister from "@astrojs/starlight/components/SidebarPersister.astro";
import SidebarSublist from "@astrojs/starlight/components/SidebarSublist.astro";
import { Portal, getPortal, portalDestinations } from "../lib/navigation";

const { entry, locale, sidebar } = Astro.locals.starlightRoute;
const zh = locale === "zh-cn";
const portal = getPortal(entry.id);
const destinations = portalDestinations(locale);
const icons: Readonly<Record<Portal, string>> = {
  [Portal.Docs]:
    "M12 7v14m0-14C8 4 4 4 2 5v14c3-1 6-1 10 2m0-14c4-3 8-3 10-2v14c-3-1-6-1-10 2",
  [Portal.Developers]: "m8 6-6 6 6 6m8-12 6 6-6 6m-3-15-2 18",
  [Portal.Learn]: "m2 9 10-5 10 5-10 5-10-5m4 2v6c4 3 8 3 12 0v-6m4-2v7",
};
---

<div class="portal-sidebar" data-portal={portal}>
  <div class="portal-directory">
    <nav
      class="portal-navigation"
      data-portal={portal}
      aria-label={zh ? "当前门户目录" : "Current portal navigation"}
    >
      <SidebarPersister><SidebarSublist sublist={sidebar} /></SidebarPersister>
    </nav>
  </div>
  <div class="portal-sidebar-footer">
    <nav
      class="portal-destinations"
      aria-label={zh ? "切换门户" : "Explore the portals"}
    >
      {
        destinations.map((destination) => (
          <a
            class="portal-link"
            href={destination.href}
            data-portal-target={destination.id}
            data-active={destination.id === portal ? "true" : undefined}
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={icons[destination.id]} />
            </svg>
            <span>{destination.label}</span>
            {destination.id === portal && (
              <span class="portal-current" aria-hidden="true" />
            )}
          </a>
        ))
      }
    </nav>
    <a
      class="portal-support"
      href={`${zh ? "/zh-cn" : ""}/resources/releases-support/`}
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="9"></circle>
        <circle cx="12" cy="12" r="4"></circle>
        <path
          d="m5.6 5.6 3.6 3.6m5.6 5.6 3.6 3.6m0-12.8-3.6 3.6m-5.6 5.6-3.6 3.6"
        ></path>
      </svg>
      <span>{zh ? "联系支持" : "Contact support"}</span>
    </a>
  </div>
</div>
