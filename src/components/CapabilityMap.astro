---
import logo from "../assets/logo.svg";
import { Icon } from "@astrojs/starlight/components";
import { localizedGuideHref } from "../lib/landing-content";
const zh = Astro.locals.starlightRoute.locale === "zh-cn";
const guide = (path: string) => localizedGuideHref(path, zh);
const alertExampleHref =
  guide("software-factory/signal-to-card") +
  (zh ? "#线上告警示例" : "#production-alert-example");
const roles = [
  {
    icon: "notes",
    label: zh ? "需求澄清" : "Clarify",
    path: "software-factory/requirements-to-card",
  },
  {
    icon: "code-branch",
    label: zh ? "开发" : "Develop",
    path: "software-factory/card-to-pr",
  },
  {
    icon: "magnifier",
    label: zh ? "评审" : "Review",
    path: "software-factory/pr-to-merge",
  },
  {
    icon: "approve-check-circle",
    label: zh ? "验证" : "Verify",
    path: "software-factory/business-verification",
  },
] as const;
const oversight = [
  {
    icon: "analytics",
    label: zh ? "用量分析" : "Usage",
    path: "administration/analytics",
  },
  { icon: "document", label: zh ? "审计" : "Audit", path: "operate/audit" },
  {
    icon: "link-alt",
    label: zh ? "追踪" : "Trace",
    path: "software-factory/observability",
  },
] as const;
const foundation = [
  {
    icon: "open-book",
    label: zh ? "空间记忆" : "Space memory",
    path: "user-guide/knowledge-context",
  },
  {
    icon: "server",
    label: zh ? "执行环境" : "Runtime",
    path: "software-factory/environments",
  },
  {
    icon: "laptop",
    label: zh ? "设备执行器" : "Device executor",
    path: "deployment/daemon",
  },
  ...oversight,
] as const;
const stages = [
  {
    title: zh ? "接收工作" : "Capture work",
    nodes: [
      {
        label: zh ? "任务收件箱" : "Task inbox",
        href: guide("user-guide/inbox-tasks"),
        icon: "list-format",
        links: [
          { name: "Jira", href: guide("integrations/jira") },
          { name: "Linear", href: guide("integrations/linear") },
        ],
      },
      {
        label: zh ? "IM 消息渠道" : "IM channels",
        href:
          guide("integrations/overview") + (zh ? "#消息渠道" : "#messaging"),
        icon: "comment",
        links: [
          {
            name: zh ? "钉钉" : "DingTalk",
            href: guide("integrations/dingtalk"),
          },
          { name: zh ? "飞书" : "Lark", href: guide("integrations/feishu") },
          { name: "Slack", href: guide("integrations/slack") },
        ],
      },
      {
        label: zh ? "员工会话" : "Employee chat",
        href: guide("user-guide/agent-chat"),
        icon: "window",
      },
      {
        label: zh ? "线上告警" : "Production alerts",
        href: alertExampleHref,
        icon: "analytics",
        links: [
          { name: "Sentry", href: guide("integrations/sentry") },
          { name: "PagerDuty", href: guide("integrations/pagerduty") },
        ],
      },
    ],
  },
  {
    title: zh ? "确认与开发" : "Scope & develop",
    nodes: [
      {
        label: zh ? "人工确认卡片" : "Approve the card",
        href: guide("user-guide/human-approval"),
        icon: "approve-check-circle",
        detail: zh
          ? "确认范围和验收条件"
          : "Agree on scope and acceptance criteria",
      },
      {
        label: zh ? "交付编排" : "Orchestrate work",
        href: guide("software-factory/orchestration"),
        icon: "random",
        links: [
          {
            name: zh ? "交付看板" : "Delivery board",
            href: guide("workflows/kanban-workbench"),
          },
        ],
      },
      {
        label: zh ? "数字员工小队" : "AI employee team",
        href: guide("user-guide/ai-employees"),
        icon: "puzzle",
        links: roles.map((r) => ({ name: r.label, href: guide(r.path) })),
      },
    ],
  },
  {
    title: zh ? "验证与发布" : "Verify & release",
    nodes: [
      {
        label: zh ? "提交 PR" : "Open a PR",
        href: guide("software-factory/card-to-pr"),
        icon: "code-branch",
        links: [{ name: "GitHub", href: guide("integrations/github") }],
      },
      {
        label: zh ? "构建与测试" : "Build & test",
        href: guide("software-factory/build-test"),
        icon: "approve-check",
        links: [
          { name: "GitHub Actions", href: guide("software-factory/cicd") },
        ],
      },
      {
        label: zh ? "生产发布" : "Release",
        href: guide("software-factory/release-governance"),
        icon: "rocket",
        detail: zh
          ? "审阅证据，决定是否发布"
          : "Review the evidence and decide whether to ship",
      },
      {
        label: zh ? "交付证据" : "Delivery evidence",
        href: guide("software-factory/evidence"),
        icon: "link-alt",
      },
    ],
  },
] as const;
---

<nav
  class="capability-map not-content"
  aria-label={zh ? "软件交付能力地图" : "Software delivery capability map"}
>
  <div class="platform">
    <header class="brand">
      <img src={logo.src} alt="" width="32" height="32" /><h3>AI Workforce</h3>
    </header>
    <div class="workflow">
      <div class="stages">
        {
          stages.map((stage) => (
            <section class="stage">
              <h4>{stage.title}</h4>
              <div class="nodes">
                {stage.nodes.map((node) => (
                  <div class="node">
                    <a class="primary" href={node.href}>
                      <Icon name={node.icon} />
                      {node.label}
                    </a>
                    {"links" in node && (
                      <div class="links">
                        {node.links.map((link) => (
                          <a href={link.href}>{link.name}</a>
                        ))}
                      </div>
                    )}
                    {"detail" in node && <small>{node.detail}</small>}
                  </div>
                ))}
              </div>
            </section>
          ))
        }
      </div>
      <div class="returns">
        <a class="repair" href={guide("software-factory/pr-to-merge")}
          ><span
            >{
              zh
                ? "验证失败，退回开发修复"
                : "Failed checks return the card to development"
            }</span
          ></a
        >
        <a class="incident" href={alertExampleHref}
          ><span
            >{
              zh
                ? "上线后收到告警，按规则启动新一轮调查"
                : "A matching production alert starts a new investigation"
            }</span
          ></a
        >
      </div>
    </div>
    <section class="foundation">
      <h4>{zh ? "平台基础能力" : "Shared platform services"}</h4><div>
        {
          foundation.map((r) => (
            <a href={guide(r.path)}>
              <Icon name={r.icon} />
              {r.label}
            </a>
          ))
        }
      </div>
    </section>
  </div>
</nav>
<style>
  .capability-map {
    container-type: inline-size;
    margin-block: 1.1rem 1.7rem;
    --ink: light-dark(#255180, #a3c6ef);
    --signal: light-dark(#974a16, #f5bd91);
    --release: light-dark(#176c60, #96dfc9);
  }
  .platform {
    border: 1.5px solid var(--ink);
    border-radius: 0.9rem;
    overflow: hidden;
    background: var(--docs-surface);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 0.9rem;
    background: linear-gradient(105deg, #0a2240, #204a6e);
  }
  h3,
  h4 {
    margin: 0;
    line-height: 1.4;
  }
  .brand h3 {
    color: white;
    font-size: 1.15rem;
  }
  .workflow {
    padding: 0.9rem;
  }
  .stages {
    --gap: 1.5rem;
    display: grid;
    gap: var(--gap);
  }
  .stage {
    --tone: var(--signal);
    position: relative;
    min-width: 0;
    border-top: 3px solid var(--tone);
    border-radius: 0.3rem;
  }
  .stage:nth-child(2) {
    --tone: var(--ink);
  }
  .stage:nth-child(3) {
    --tone: var(--release);
  }
  .stage h4 {
    font-size: 0.95rem;
    color: var(--tone);
    padding: 0.45rem 0.1rem;
  }
  .stage:not(:last-child)::after {
    content: "↓";
    position: absolute;
    top: 100%;
    left: 50%;
    color: var(--ink);
    font-size: 1.25rem;
    line-height: var(--gap);
  }
  .nodes {
    display: grid;
    gap: 0.35rem;
  }
  .node {
    padding: 0.4rem 0.5rem;
    background: var(--docs-soft);
    border-radius: 0.45rem;
  }
  a {
    color: var(--docs-ink);
    text-decoration: none;
  }
  a:hover {
    background: var(--docs-hover);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  a:focus-visible {
    outline: 2px solid var(--docs-accent);
    outline-offset: 2px;
  }
  .primary,
  .foundation a {
    display: flex;
    align-items: center;
    gap: 0.38rem;
  }
  .primary {
    font-size: 0.85rem;
    font-weight: 650;
  }
  .primary svg {
    color: var(--tone);
    flex-shrink: 0;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.07rem 0.5rem;
  }
  .links a,
  .node small {
    font-size: 0.75rem;
    color: var(--docs-body);
    line-height: 1.5;
  }
  .links a {
    text-decoration: underline;
    text-underline-offset: 0.15em;
    text-decoration-color: var(--docs-line-hover);
  }
  .returns {
    display: grid;
    gap: 0.25rem;
    padding-top: 0.5rem;
  }
  .returns a {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: 0.77rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--release);
  }
  .returns a::before {
    content: "↰";
    margin-right: 0.4rem;
  }
  .returns span {
    background: var(--docs-surface);
    padding: 0.2rem 0.4rem;
  }
  .foundation {
    border-top: 1px solid var(--docs-line);
    background: var(--docs-soft);
    padding: 0.55rem 0.9rem;
  }
  .foundation h4 {
    font-size: 0.78rem;
    color: var(--docs-body);
    margin-bottom: 0.3rem;
  }
  .foundation div {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.2rem 0.85rem;
  }
  .foundation a {
    font-size: 0.75rem;
  }
  @container (min-width:35rem) {
    .stages {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .stage:not(:last-child)::after {
      content: "→";
      left: 100%;
      top: 44%;
      width: var(--gap);
      text-align: center;
    }
    .returns {
      position: relative;
      display: block;
      height: 4.5rem;
      padding: 0;
    }
    .returns a {
      pointer-events: none;
      position: absolute;
      align-items: flex-end;
      top: 0;
      border: solid currentColor;
      border-width: 0 1.5px 1.5px;
      border-radius: 0 0 0.45rem 0.45rem;
    }
    .returns .repair {
      left: 50%;
      right: 18%;
      height: 1.7rem;
      color: var(--ink);
    }
    .returns .incident {
      left: 15.5%;
      right: 15.5%;
      height: 3.55rem;
    }
    .returns a::before {
      content: "▴";
      position: absolute;
      top: -0.3rem;
      left: 0;
      transform: translateX(-55%);
    }
    .returns span {
      pointer-events: auto;
      transform: translateY(50%);
    }
  }
</style>
