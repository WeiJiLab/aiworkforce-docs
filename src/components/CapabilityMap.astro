---
import logo from "../assets/logo.svg";
import { Icon } from "@astrojs/starlight/components";
import { localizedGuideHref } from "../lib/landing-content";
const zh = Astro.locals.starlightRoute.locale === "zh-cn";
const guide = (path: string) => localizedGuideHref(path, zh);
const alertExampleHref =
  guide("software-factory/signal-to-card") +
  (zh ? "#线上告警示例" : "#production-alert-example");
const channels = [
  {
    icon: "list-format",
    label: zh ? "任务收件箱" : "Task inbox",
    detail: zh ? "导入工单与需求" : "Imported issues",
    href: guide("user-guide/inbox-tasks"),
  },
  {
    icon: "comment",
    label: zh ? "IM 消息渠道" : "IM channels",
    detail: zh ? "接收团队消息" : "Receive team messages",
    href: guide("integrations/overview") + (zh ? "#消息渠道" : "#messaging"),
  },
  {
    icon: "window",
    label: zh ? "员工会话" : "Employee chat",
    detail: zh ? "与数字员工对话" : "Talk to an employee",
    href: guide("user-guide/agent-chat"),
  },
  {
    icon: "analytics",
    label: zh ? "线上告警" : "Production alerts",
    detail: zh ? "按规则启动调查" : "Trigger an investigation",
    href: alertExampleHref,
  },
] as const;
const roles = [
  {
    icon: "notes",
    label: zh ? "需求澄清" : "Clarify",
    path: "software-factory/requirements-to-card",
  },
  {
    icon: "code-branch",
    label: zh ? "开发" : "Develop",
    path: "software-factory/card-to-pr",
  },
  {
    icon: "magnifier",
    label: zh ? "评审" : "Review",
    path: "software-factory/pr-to-merge",
  },
  {
    icon: "approve-check-circle",
    label: zh ? "验证" : "Verify",
    path: "software-factory/business-verification",
  },
] as const;
const oversight = [
  {
    icon: "analytics",
    label: zh ? "用量分析" : "Usage",
    path: "administration/analytics",
  },
  { icon: "document", label: zh ? "审计" : "Audit", path: "operate/audit" },
  {
    icon: "link-alt",
    label: zh ? "追踪" : "Trace",
    path: "software-factory/observability",
  },
] as const;
const foundation = [
  {
    icon: "open-book",
    label: zh ? "空间记忆" : "Space memory",
    path: "user-guide/knowledge-context",
  },
  {
    icon: "server",
    label: zh ? "执行环境" : "Runtime",
    path: "software-factory/environments",
  },
  {
    icon: "laptop",
    label: zh ? "设备执行器" : "Device executor",
    path: "deployment/daemon",
  },
  ...oversight,
] as const;
const integrations = [
  {
    title: zh ? "工单来源" : "Issue tracking",
    detail: zh ? "只读导入到任务收件箱" : "Read-only import into the inbox",
    tools: [
      { name: "Jira", path: "integrations/jira" },
      { name: "Linear", path: "integrations/linear" },
    ],
  },
  {
    title: zh ? "团队消息" : "Messaging",
    detail: zh
      ? "接收消息或发送通知"
      : "Receive messages or send notifications",
    tools: [
      { name: zh ? "钉钉" : "DingTalk", path: "integrations/dingtalk" },
      { name: zh ? "飞书" : "Lark", path: "integrations/feishu" },
      { name: "Slack", path: "integrations/slack" },
    ],
  },
  {
    title: zh ? "代码与流水线" : "Code & CI",
    detail: zh
      ? "关联 PR，读取流水线结果"
      : "Link PRs and read workflow results",
    tools: [
      { name: "GitHub", path: "integrations/github" },
      { name: "GitHub Actions", path: "software-factory/cicd" },
    ],
  },
  {
    title: zh ? "线上监控" : "Monitoring",
    detail: zh
      ? "接收 Issue 和 Incident 事件"
      : "Receive issue and incident events",
    tools: [
      { name: "Sentry", path: "integrations/sentry" },
      { name: "PagerDuty", path: "integrations/pagerduty" },
    ],
  },
] as const;
---

<nav
  class="capability-map not-content"
  aria-label={zh ? "软件交付能力地图" : "Software delivery capability map"}
>
  <div class="topology">
    <section class="platform">
      <header class="brand">
        <img src={logo.src} alt="" width="35" height="35" /><h3>
          AI Workforce
        </h3>
      </header>
      <div class="workspace">
        <section class="intake">
          <h4>{zh ? "团队协作入口" : "Team channels"}</h4>
          <div class="channels">
            {
              channels.map((c) => (
                <a class="channel" href={c.href}>
                  <>
                    <Icon name={c.icon} />
                    <span>
                      <>
                        <strong>{c.label}</strong>
                        <small>{c.detail}</small>
                      </>
                    </span>
                  </>
                </a>
              ))
            }
          </div>
        </section>
        <section class="workbench">
          <h4>{zh ? "软件交付工作台" : "Delivery workbench"}</h4>
          <a class="lane" href={guide("software-factory/orchestration")}
            ><Icon name="random" />{zh ? "交付编排" : "Orchestration"}</a
          >
          <div class="squad">
            <a class="squad-title" href={guide("user-guide/ai-employees")}
              ><Icon name="puzzle" />{
                zh ? "数字员工小队" : "AI employee team"
              }</a
            ><div class="roles">
              {
                roles.map((r) => (
                  <a href={guide(r.path)}>
                    <Icon name={r.icon} />
                    {r.label}
                  </a>
                ))
              }
            </div>
          </div>
          <div class="delivery">
            <a href={guide("workflows/kanban-workbench")}
              ><Icon name="list-format" />{
                zh ? "交付看板" : "Delivery board"
              }</a
            ><a href={guide("software-factory/evidence")}
              ><Icon name="link-alt" />{zh ? "交付证据" : "Evidence"}</a
            >
          </div>
        </section>
      </div>
      <section class="foundation">
        <h4>{zh ? "平台基础能力" : "Shared platform services"}</h4><div>
          {
            foundation.map((r) => (
              <a href={guide(r.path)}>
                <Icon name={r.icon} />
                {r.label}
              </a>
            ))
          }
        </div>
      </section>
    </section>
    <section class="external">
      <h3><Icon name="link" />{zh ? "外部系统" : "External systems"}</h3>
      <div class="connections">
        {
          integrations.map((group) => (
            <section class="connection">
              <>
                <h4>{group.title}</h4>
                <div class="tools">
                  {group.tools.map((tool) => (
                    <a href={guide(tool.path)}>{tool.name}</a>
                  ))}
                </div>
                <small>{group.detail}</small>
              </>
            </section>
          ))
        }
      </div>
      <a class="catalog" href={guide("integrations/overview")}
        >{zh ? "查看集成目录" : "Integration guides"}<Icon
          name="right-arrow"
        /></a
      >
    </section>
  </div>
</nav>
<style>
  .capability-map {
    container-type: inline-size;
    margin-block: 1.1rem 1.7rem;
    --brand: light-dark(#254f84, #a7c7ee);
    --outside: light-dark(#166a61, #9ed4c5);
  }
  .topology {
    display: grid;
    gap: 1.1rem;
    align-items: start;
  }
  .platform,
  .external,
  .workspace > * {
    min-width: 0;
  }
  .platform {
    border: 2px solid var(--brand);
    border-radius: 0.9rem;
    overflow: hidden;
    background: var(--docs-surface);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 0.85rem;
    background: linear-gradient(105deg, #0a2240, #204a6e);
    color: white;
  }
  .brand img {
    border-radius: 0.48rem;
  }
  h3,
  h4 {
    margin: 0;
    line-height: 1.35;
  }
  .brand h3 {
    color: white;
    font-size: 1.18rem;
    letter-spacing: -0.025em;
  }
  h4 {
    font-size: 0.87rem;
    color: var(--docs-ink);
  }
  a {
    color: var(--docs-ink);
    text-decoration: none;
  }
  a:hover {
    background-color: var(--docs-hover);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  a:focus-visible {
    outline: 2px solid var(--docs-accent);
    outline-offset: 2px;
  }
  .workspace {
    padding: 0.8rem;
    display: grid;
    gap: 1rem;
  }
  .workspace h4 {
    margin-bottom: 0.6rem;
    color: var(--brand);
  }
  .channels,
  .workbench {
    display: grid;
    gap: 0.35rem;
  }
  .workbench {
    align-content: start;
  }
  .workbench h4 {
    margin-bottom: 0.25rem;
  }
  .channel,
  .lane,
  .squad,
  .delivery {
    border: 1px solid var(--docs-line);
    border-radius: 0.48rem;
  }
  .channel {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.32rem 0.48rem;
  }
  .platform svg {
    flex-shrink: 0;
    color: var(--brand);
  }
  strong,
  small {
    display: block;
    line-height: 1.4;
  }
  strong,
  .lane,
  .squad-title {
    font-size: 0.84rem;
    font-weight: 650;
  }
  small {
    font-size: 0.72rem;
    color: var(--docs-muted);
  }
  .lane,
  .squad-title,
  .roles a,
  .delivery a,
  .foundation a,
  .catalog,
  .external h3 {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .lane,
  .squad-title {
    padding: 0.52rem;
  }
  .squad {
    background: color-mix(in srgb, var(--brand) 5%, var(--docs-surface));
  }
  .roles,
  .delivery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .roles {
    padding: 0 0.4rem 0.4rem;
    gap: 0.25rem;
  }
  .roles a {
    background: var(--docs-surface);
    border-radius: 0.3rem;
  }
  .roles a,
  .delivery a {
    padding: 0.35rem;
    line-height: 1.3;
    font-size: 0.76rem;
  }
  .delivery a {
    justify-content: center;
  }
  .foundation {
    border-top: 1px solid var(--docs-line);
    background: var(--docs-soft);
    padding: 0.65rem 0.8rem;
  }
  .foundation h4 {
    font-size: 0.78rem;
    color: var(--docs-body);
    margin-bottom: 0.35rem;
  }
  .foundation div {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.2rem;
  }
  .foundation a {
    font-size: 0.75rem;
    padding: 0.28rem 0.1rem;
    line-height: 1.25;
  }
  .external {
    position: relative;
    border: 1px dashed color-mix(in srgb, var(--outside) 60%, var(--docs-line));
    padding: 0.75rem;
    border-radius: 0.8rem;
    background: color-mix(in srgb, var(--outside) 4%, var(--docs-surface));
  }
  .external h3,
  .catalog {
    color: var(--outside);
    font-size: 0.93rem;
  }
  .connections {
    display: grid;
    gap: 0.55rem;
    margin: 0.7rem 0;
  }
  .connection {
    border-inline-start: 2px solid
      color-mix(in srgb, var(--outside) 48%, var(--docs-line));
    padding-inline-start: 0.5rem;
  }
  .connection h4 {
    color: var(--docs-body);
    font-size: 0.73rem;
    font-weight: 550;
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.5rem;
    margin: 0.15rem 0;
  }
  .tools a {
    color: var(--outside);
    line-height: 1.45;
    font-size: 0.84rem;
    font-weight: 650;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--outside) 35%, transparent);
    text-underline-offset: 0.16em;
  }
  .catalog {
    border-top: 1px solid var(--docs-line);
    padding-top: 0.45rem;
    font-size: 0.78rem;
  }
  @container (min-width:24rem) {
    .workspace {
      grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    }
  }
  @container (min-width:37rem) {
    .topology {
      grid-template-columns: minmax(0, 2.5fr) minmax(0, 1fr);
      align-items: center;
    }
    .external::before {
      content: "";
      position: absolute;
      right: 100%;
      top: 50%;
      width: 1.1rem;
      border-top: 2px dotted var(--outside);
    }
  }
  @container (max-width:36.99rem) {
    .external::before {
      content: "";
      position: absolute;
      bottom: 100%;
      left: 50%;
      height: 1.1rem;
      border-left: 2px dotted var(--outside);
    }
    .connections {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
