---
import CapabilityStack from "./CapabilityStack.astro";
import { Icon } from "@astrojs/starlight/components";
import { localizedGuideHref } from "../lib/landing-content";
const zh = Astro.locals.starlightRoute.locale === "zh-cn";
const guide = (path: string) => localizedGuideHref(path, zh);
const alertExampleHref =
  guide("software-factory/signal-to-card") +
  (zh ? "#生产告警示例" : "#production-alert-example");
const channels = [
  {
    icon: "list-format",
    label: zh ? "任务收件箱" : "Task inbox",
    tools: [
      { name: "Jira", path: "integrations/jira" },
      { name: "Linear", path: "integrations/linear" },
      {
        name: zh ? "云效 Projex" : "Yunxiao Projex",
        path: "integrations/yunxiao" + (zh ? "#导入-projex" : "#projex-import"),
      },
    ],
    href: guide("user-guide/inbox-tasks"),
  },
  {
    icon: "comment",
    label: zh ? "IM 消息渠道" : "IM channels",
    tools: [
      { name: zh ? "钉钉" : "DingTalk", path: "integrations/dingtalk" },
      { name: zh ? "飞书" : "Lark", path: "integrations/feishu" },
      { name: "Slack", path: "integrations/slack" },
    ],
    href: guide("integrations/overview") + (zh ? "#消息渠道" : "#messaging"),
  },
  {
    icon: "window",
    label: zh ? "员工会话" : "Employee chat",
    detail: zh ? "与数字员工对话" : "Talk to an employee",
    href: guide("user-guide/agent-chat"),
  },
  {
    icon: "analytics",
    label: zh ? "线上告警" : "Production alerts",
    tools: [
      { name: "PagerDuty", path: "integrations/pagerduty" },
      { name: "Sentry", path: "integrations/sentry" },
    ],
    href: alertExampleHref,
  },
] as const;
const devops = [
  {
    icon: "server",
    label: zh ? "执行环境" : "Runtime",
    href: guide("software-factory/environments"),
    tools: [
      {
        name: zh ? "设备执行器" : "Device executor",
        path: "deployment/daemon",
      },
    ],
  },
  {
    icon: "code-branch",
    label: zh ? "代码仓库" : "Repositories",
    href: guide("integrations/code-repositories"),
    tools: [
      { name: "GitHub", path: "integrations/github" },
      { name: "GitLab", path: "integrations/gitlab" },
      {
        name: zh ? "云效 Codeup" : "Yunxiao Codeup",
        path:
          "integrations/yunxiao" +
          (zh ? "#codeup-仓库" : "#codeup-repositories"),
      },
    ],
  },
  {
    icon: "approve-check",
    label: zh ? "构建与测试" : "Build & test",
    href: guide("software-factory/build-test"),
    tools: [
      { name: "GitHub Actions", path: "software-factory/cicd" },
      {
        name: zh ? "云效 Flow" : "Yunxiao Flow",
        path:
          "integrations/yunxiao" +
          (zh ? "#在交付项目上使用-flow" : "#flow-on-a-delivery-project"),
      },
    ],
  },
  {
    icon: "rocket",
    label: zh ? "发布与部署" : "Release & deploy",
    href: guide("software-factory/release-governance"),
    tools: [
      {
        name: zh ? "合并 PR" : "Merge a PR",
        path: "software-factory/pr-to-merge",
      },
      { name: "CI/CD", path: "software-factory/cicd" },
    ],
  },
] as const;
const boardLanes = [
  { name: zh ? "需求" : "Scope", step: zh ? "确认范围" : "Confirm" },
  { name: zh ? "开发" : "Dev", step: zh ? "Agent 执行" : "Run agent" },
  { name: zh ? "验证" : "Verify", step: zh ? "审阅结果" : "Review" },
];
const roles = [
  {
    icon: "notes",
    label: zh ? "需求澄清" : "Clarify",
    path: "software-factory/requirements-to-card",
  },
  {
    icon: "code-branch",
    label: zh ? "开发" : "Develop",
    path: "software-factory/card-to-pr",
  },
  {
    icon: "magnifier",
    label: zh ? "评审" : "Review",
    path: "software-factory/pr-to-merge",
  },
  {
    icon: "approve-check-circle",
    label: zh ? "验证" : "Verify",
    path: "software-factory/business-verification",
  },
] as const;
const oversight = [
  {
    icon: "analytics",
    label: zh ? "用量分析" : "Usage",
    path: "administration/analytics",
  },
  { icon: "document", label: zh ? "审计" : "Audit", path: "operate/audit" },
  {
    icon: "link-alt",
    label: zh ? "追踪" : "Trace",
    path: "software-factory/observability",
  },
] as const;
---

<nav
  class="capability-map not-content"
  aria-label={zh ? "软件工厂如何运转" : "Software delivery capability map"}
>
  <div class="topology">
    <CapabilityStack
      title={zh ? "团队协作入口" : "Team channels"}
      icon="laptop"
      side="intake"
      cards={channels}
      guide={guide}
    />
    <a class="bridge inbound" href={guide("software-factory/signal-to-card")}
      ><Icon name="link" /><span>{zh ? "人工确认" : "Confirm"}</span></a
    >
    <section class="platform">
      <h3>AI Workforce</h3>
      <div class="layers">
        <div class="board">
          <a class="board-title" href={guide("workflows/kanban-workbench")}>
            <Icon name="list-format" />
            {zh ? "交付工作台" : "Delivery workbench"}
          </a>
          <ol class="board-lanes" role="list">
            {
              boardLanes.map(({ name, step }) => (
                <li>
                  <span class="lane-name">{name}</span>
                  <span class="lane-card">{step}</span>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="squad">
          <a class="team" href={guide("user-guide/expert-workbench")}
            ><Icon name="puzzle" />{zh ? "专家工作台" : "Expert workbench"}</a
          >
          <div class="roles">
            {
              roles.map((r) => (
                <a href={guide(r.path)}>
                  <Icon name={r.icon} />
                  {r.label}
                </a>
              ))
            }
          </div>
        </div>
        <div class="memory">
          <a class="layer" href={guide("user-guide/knowledge-context")}>
            <Icon name="open-book" />
            {zh ? "知识与空间记忆" : "Knowledge & workspace memory"}
          </a>
        </div>
      </div>
    </section>
    <a
      class="bridge outbound"
      href={guide("software-factory/cicd")}
      aria-label={zh ? "DevOps 集成指南" : "DevOps integration guide"}
      ><Icon name="link" /><span>{zh ? "执行交付" : "Run CI/CD"}</span></a
    >
    <CapabilityStack
      title="DevOps"
      icon="code-branch"
      side="devops"
      cards={devops}
      guide={guide}
    />
    <div class="return">
      <a href={guide("software-factory/evidence")}
        >{zh ? "同步交付结果" : "Sync delivery results"}</a
      >
    </div>
  </div>
  <div class="oversight">
    {
      oversight.map((r) => (
        <a href={guide(r.path)}>
          <Icon name={r.icon} />
          {r.label}
        </a>
      ))
    }
  </div>
  <a class="monitor-link" href={alertExampleHref}
    ><Icon name="analytics" />{
      zh
        ? "线上告警如何进入交付看板？"
        : "How does a production alert reach the board?"
    }
    <Icon name="right-arrow" /></a
  >
</nav>
<style>
  .capability-map {
    container-type: inline-size;
    margin-block: 1rem 1.75rem;
    --orange: light-dark(#9c4916, #f5b381);
    --blue: light-dark(#2956b0, #9fbdfc);
    --teal: light-dark(#117568, #88d8c4);
  }
  .topology {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    border: 1px solid var(--docs-line);
    border-radius: 0.95rem;
    padding: 1rem;
    background:
      radial-gradient(
          circle,
          color-mix(in srgb, var(--docs-muted) 23%, transparent) 0.7px,
          transparent 0.9px
        )
        0 0 / 12px 12px,
      var(--docs-surface);
  }
  .topology section {
    min-width: 0;
  }
  h3 {
    font-size: 0.96rem;
    margin: 0;
    text-align: center;
    line-height: 1.45;
  }
  a {
    color: var(--docs-ink);
    text-decoration: none;
  }
  a:hover {
    background-color: var(--docs-hover);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  a:focus-visible {
    outline: 2px solid var(--docs-accent);
    outline-offset: 2px;
    z-index: 1;
  }
  .bridge {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    justify-self: center;
    min-height: 2.5rem;
    color: var(--tone);
    font-size: 0.69rem;
    font-weight: 650;
    line-height: 1.35;
    text-align: center;
  }
  .bridge svg {
    background: var(--docs-surface);
    box-sizing: content-box;
    padding: 0.28rem;
    border: 1px solid currentColor;
    border-radius: 50%;
  }
  .inbound {
    --tone: var(--orange);
  }
  .outbound {
    --tone: var(--teal);
  }
  .layer,
  .team {
    font-size: 0.88rem;
    font-weight: 650;
  }
  .platform {
    --tone: var(--blue);
    border: 2px solid var(--tone);
    border-radius: 0.75rem;
    background: var(--docs-surface);
    align-self: center;
  }
  .platform h3 {
    padding: 0.55rem;
    color: white;
    background: #244e9c;
    border-radius: 0.53rem 0.53rem 0 0;
    letter-spacing: 0.015em;
  }
  .layers {
    display: grid;
    gap: 0.5rem;
    padding: 0.6rem;
  }
  .board {
    padding: 0.45rem;
    border: 1px solid var(--tone);
    border-radius: 0.45rem;
    background: color-mix(in srgb, var(--tone) 8%, var(--docs-surface));
  }
  .board-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    color: var(--tone);
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1.35;
    text-align: center;
  }
  .board-title svg {
    flex-shrink: 0;
  }
  .board-lanes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.4rem;
    margin: 0.45rem 0;
    padding: 0;
    list-style: none;
    font-size: 0.7rem;
    line-height: 1.3;
    text-align: center;
  }
  .board-lanes li {
    margin: 0;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 0.2rem;
    position: relative;
    min-width: 0;
    padding: 0.2rem;
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--tone) 12%, var(--docs-surface));
  }
  .board-lanes li + li::before {
    content: "";
    position: absolute;
    top: 50%;
    left: -0.34rem;
    width: 0.22rem;
    height: 0.22rem;
    border: solid var(--tone);
    border-width: 1px 1px 0 0;
    transform: translateY(-50%) rotate(45deg);
  }
  .lane-name {
    font-weight: 650;
  }
  .lane-card {
    display: grid;
    place-items: center;
    padding: 0.22rem 0.12rem;
    border-radius: 0.2rem;
    overflow-wrap: anywhere;
    background: var(--docs-surface);
  }
  .memory,
  .squad {
    border: 1px solid color-mix(in srgb, var(--tone) 65%, var(--docs-line));
    border-radius: 0.45rem;
  }
  .layer,
  .team,
  .roles a,
  .oversight a,
  .monitor-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.42rem;
  }
  .layer,
  .team {
    padding: 0.5rem 0.25rem;
  }
  .platform svg {
    color: var(--tone);
  }
  .roles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.3rem;
    padding: 0 0.4rem 0.45rem;
  }
  .roles a {
    font-size: 0.78rem;
    padding: 0.25rem;
    border-radius: 0.35rem;
    background: color-mix(in srgb, var(--tone) 8%, var(--docs-surface));
  }
  .oversight {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1.2rem;
    margin-top: 0.75rem;
  }
  .oversight a {
    font-size: 0.8rem;
  }
  .return {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }
  .return a,
  .monitor-link {
    font-size: 0.8rem;
    color: var(--teal);
    font-weight: 600;
  }
  .monitor-link {
    width: fit-content;
    margin: 0.75rem auto 0;
    text-align: center;
  }
  @container (min-width:37rem) {
    .topology {
      --bridge: 3.3rem;
      --rail: 0.45rem;
      --return-height: 2.65rem;
      --return-baseline: 0.6rem;
      /* Distance from the grid edge to the center of the inset DevOps card. */
      --return-end: calc(
        (100% - 2 * var(--bridge)) / 6.9 - var(--rail) / 2 - 0.5px
      );
      grid-template-columns:
        minmax(0, 1fr) var(--bridge) minmax(0, 1.45fr) var(--bridge)
        minmax(0, 1fr);
      align-items: center;
      gap: 0;
      padding: 1rem 0.75rem 0.7rem;
    }
    .bridge {
      justify-self: stretch;
      isolation: isolate;
    }
    .bridge::before {
      content: "";
      position: absolute;
      z-index: -1;
      inset-inline: 0;
      top: calc(50% - 0.47rem);
      border-top: 1px solid currentColor;
    }
    .bridge::after {
      content: "";
      position: absolute;
      right: 1px;
      top: calc(50% - 0.47rem - 3px);
      width: 6px;
      height: 6px;
      border: solid currentColor;
      border-width: 1px 1px 0 0;
      transform: rotate(45deg);
    }
    .return {
      grid-column: 1/-1;
      height: var(--return-height);
      align-items: flex-end;
      padding-inline-start: 50%;
      padding-inline-end: var(--return-end);
    }
    .return::before {
      content: "";
      position: absolute;
      left: 50%;
      right: calc(var(--return-end) + 0.5rem);
      bottom: var(--return-baseline);
      top: 0;
      border: solid var(--teal);
      border-width: 0 0 1px 1px;
      border-bottom-left-radius: 0.4rem;
    }
    .return::after {
      content: "▴";
      position: absolute;
      left: 50%;
      top: -0.35rem;
      color: var(--teal);
      transform: translateX(-45%);
    }
    .return a {
      position: relative;
      background: var(--docs-surface);
      padding: 0 0.3rem;
      text-align: center;
    }
  }
  @container (max-width:36.99rem) {
    .topology {
      gap: 0.6rem;
    }
    .bridge {
      flex-direction: row;
      gap: 0.35rem;
      padding-inline: 0.5rem;
    }
    .bridge::after {
      content: "↓";
    }
    .return::before {
      content: "↳";
      color: var(--teal);
      margin-right: 0.4rem;
    }
  }
</style>
