---
import {
  getHomeContent,
  localizedGuideHref,
  type HomeSection,
} from "../lib/landing-content";
import { withBase } from "../lib/site.mjs";

interface Props {
  section: HomeSection;
}

const { section } = Astro.props;
const zh = Astro.locals.starlightRoute.locale === "zh-cn";
const content = getHomeContent(zh);
const cards = (
  items: readonly { title: string; description: string; href: string }[],
) =>
  items.map((item) => ({ ...item, href: localizedGuideHref(item.href, zh) }));

const sectionCards: Partial<
  Record<
    HomeSection,
    readonly { title: string; description: string; href: string }[]
  >
> = {
  applications: content.applications,
  "build-software": content.buildSoftware,
  "automate-work": content.automateWork,
  "use-employees": content.useEmployees,
  build: content.build,
  "run-workflows": content.runWorkflows,
  daemon: content.daemon,
  integrations: content.integrations,
};
---

{
  section === "cta" && (
    <div class="home-cta not-content">
      <a
        class="home-cta-primary"
        href={localizedGuideHref(content.primaryCta.href, zh)}
      >
        {content.primaryCta.title}
      </a>
      <a
        class="home-cta-secondary"
        href={localizedGuideHref(content.secondaryCta.href, zh)}
      >
        {content.secondaryCta.title}
      </a>
    </div>
  )
}
{
  section !== "cta" &&
    section !== "agents" &&
    sectionCards[section] &&
    (section === "applications" ? (
      <div class="path-grid not-content">
        {cards(sectionCards[section]!).map((item) => (
          <a class="path-card" href={item.href}>
            <div class="path-card-heading">
              <h3>{item.title}</h3>
              <span aria-hidden="true">→</span>
            </div>
            <p class="path-description">{item.description}</p>
          </a>
        ))}
      </div>
    ) : (
      <div class="domain-grid not-content">
        {cards(sectionCards[section]!).map(({ title, description, href }) => (
          <a class="domain-link" href={href}>
            <div>
              <h3>{title}</h3>
              <p>{description}</p>
            </div>
            <span aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    ))
}
{
  section === "agents" && (
    <section
      class="agent-section not-content"
      aria-label={content.agents.title}
    >
      <div>
        <p>{content.agents.description}</p>
      </div>
      <div class="agent-links">
        {content.agents.links.map((link) => (
          <a href={link.href.startsWith("/") ? withBase(link.href) : link.href}>
            <code>{link.title}</code>
            <span>{link.description} ↗</span>
          </a>
        ))}
      </div>
    </section>
  )
}
