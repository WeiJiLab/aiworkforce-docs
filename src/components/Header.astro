---
import SiteTitle from "@astrojs/starlight/components/SiteTitle.astro";
import Search from "@astrojs/starlight/components/Search.astro";
import LanguageSelect from "@astrojs/starlight/components/LanguageSelect.astro";
import ThemeSelect from "@astrojs/starlight/components/ThemeSelect.astro";
import { externalNav, getPortal, portalDestinations } from "../lib/navigation";

const locale = Astro.locals.starlightRoute.locale;
const zh = locale === "zh-cn";
const current = getPortal(Astro.locals.starlightRoute.entry.id);
const destinations = portalDestinations(locale);
const outbound = externalNav(locale);
const consoleLink = outbound.find((item) => item.id === "console");
const newWindow = zh ? "（新窗口打开）" : " (opens in a new tab)";
---

<div class="docs-header">
  <div class="docs-header-start">
    <div class="docs-brand"><SiteTitle /></div>
    <nav class="site-nav" aria-label={zh ? "站点导航" : "Site"}>
      {
        destinations.map((destination) => (
          <a
            class="site-nav-link"
            href={destination.href}
            data-active={destination.id === current ? "true" : undefined}
            aria-current={destination.id === current ? "page" : undefined}
          >
            {destination.label}
          </a>
        ))
      }
    </nav>
  </div>
  <div class="docs-header-center">
    <div class="docs-search"><Search /></div>
  </div>
  <div class="docs-header-end">
    <div class="docs-preferences">
      <div class="docs-preference">
        <ThemeSelect />
        <span class="docs-preference-tooltip" aria-hidden="true"
          >{zh ? "切换主题" : "Change theme"}</span
        >
      </div>
      <div class="docs-preference">
        <LanguageSelect />
        <span class="docs-preference-tooltip" aria-hidden="true"
          >{zh ? "切换语言" : "Change language"}</span
        >
      </div>
    </div>
    {
      consoleLink && (
        <a
          class="site-nav-console"
          href={consoleLink.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          {consoleLink.label}
          <span class="visually-hidden">{newWindow}</span>
        </a>
      )
    }
  </div>
</div>

<script>
  const themeName = () =>
    document.documentElement.dataset.theme === "light" ? "light" : "dark";

  const diagramSource = (pre: Element) => {
    const code = pre.querySelector("code");
    const text =
      code instanceof HTMLElement
        ? code.innerText
        : pre instanceof HTMLElement
          ? pre.innerText
          : (pre.textContent ?? "");
    return text.replace(/\n$/, "").trim();
  };

  const isMermaid = (pre: Element) =>
    /mermaid/i.test(
      `${pre.getAttribute("data-language") ?? ""} ${pre.querySelector("code")?.className ?? ""}`,
    );

  const mounts: { source: string; figure: HTMLElement }[] = [];
  let sequence = 0;

  const draw = async (
    mermaid: {
      initialize: (config: object) => void;
      render: (id: string, source: string) => Promise<{ svg: string }>;
    },
    theme: string,
  ) => {
    const styles = getComputedStyle(document.documentElement);
    const token = (name: string) => styles.getPropertyValue(name).trim();
    mermaid.initialize({
      startOnLoad: false,
      securityLevel: "strict",
      theme: "base",
      fontFamily: token("--sl-font"),
      themeVariables: {
        darkMode: theme === "dark",
        background: token("--docs-surface"),
        primaryColor: token("--docs-surface"),
        primaryTextColor: token("--docs-ink"),
        primaryBorderColor: token("--docs-line-hover"),
        lineColor: token("--docs-muted"),
        secondaryColor: token("--docs-accent-soft"),
        tertiaryColor: token("--docs-soft"),
        clusterBkg: token("--docs-soft"),
        clusterBorder: token("--docs-line"),
        edgeLabelBackground: token("--docs-surface"),
      },
      themeCSS: `
        .node.agent > .label-container { fill: var(--docs-soft); }
        .node.human > .label-container {
          fill: var(--docs-accent-soft);
          stroke: var(--docs-accent);
        }
      `,
    });
    for (const mount of mounts) {
      try {
        const { svg } = await mermaid.render(
          `mermaid-diagram-${sequence++}`,
          mount.source,
        );
        mount.figure.innerHTML = svg;
      } catch (error) {
        console.error("Mermaid render failed", error);
        const fallback = document.createElement("pre");
        fallback.textContent = mount.source;
        mount.figure.replaceChildren(fallback);
      }
    }
  };

  const blocks = [...document.querySelectorAll("pre")].filter(isMermaid);
  if (blocks.length) {
    const mermaid = (await import("mermaid")).default;
    for (const pre of blocks) {
      const source = diagramSource(pre);
      const host = pre.closest(".expressive-code") ?? pre;
      const figure = document.createElement("figure");
      figure.className = "mermaid-diagram";
      host.replaceWith(figure);
      mounts.push({ source, figure });
    }
    let renderedTheme = themeName();
    await draw(mermaid, renderedTheme);
    new MutationObserver(() => {
      const next = themeName();
      if (next === renderedTheme) return;
      renderedTheme = next;
      draw(mermaid, next).catch((error) => {
        console.error("Mermaid theme update failed", error);
      });
    }).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
  }
</script>
