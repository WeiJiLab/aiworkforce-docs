---
interface Props {
  href?: string;
  label: string;
  type?: "button" | "submit";
}
const { href, label, type = "button" } = Astro.props;
const Tag = href ? "a" : "button";
---

<Tag
  class="docs-icon-button"
  {...href ? { href } : { type }}
  aria-label={label}
>
  <slot />
  <span class="docs-tooltip" role="tooltip">{label}</span>
</Tag>
