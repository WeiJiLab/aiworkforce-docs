---
import PageTitle from "@astrojs/starlight/components/PageTitle.astro";
import IconButton from "./IconButton.astro";
import { canonicalPage, findSection, sectionHref } from "../lib/navigation";

const { entry, locale } = Astro.locals.starlightRoute;
const zh = locale === "zh-cn";
const id = entry.id.replace(/\/?index$/, "") || "index";
const section = findSection(entry.id);
const isHome = canonicalPage(entry.id) === "index";
const support = entry.data.status ?? "available";
const supportCopy =
  support === "beta"
    ? zh
      ? "Beta：可以使用，但行为尚未稳定。以本页写明的边界为准。"
      : "Beta: you can use this, but the behavior is not stable yet. Follow the boundaries on this page."
    : support === "limited"
      ? zh
        ? "部分支持：当前版本只覆盖本页写明的场景。"
        : "Limited: the current release covers only the scenarios this page describes."
      : support === "planned"
        ? zh
          ? "规划中：当前版本尚未提供此能力。本页只说明边界，避免把它当成已经支持的功能。"
          : "Planned: this capability is not in the current release. This page records the boundary so it is not treated as available."
        : "";
---

<header class="document-heading">
  <p class="document-eyebrow">
    {
      section ? (
        <a href={sectionHref(section, locale)}>
          {zh ? section.zh : section.label}
        </a>
      ) : (
        "AI Workforce"
      )
    }
  </p>
  <div class="document-title">
    <PageTitle />
    <div class="document-actions" data-pagefind-ignore>
      <IconButton href={`/${id}.md`} label="查看 Markdown 原文"
        ><svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
          ><path d="M7 3h7l4 4v14H7zM14 3v5h4M10 12h5M10 16h5"></path></svg
        ></IconButton
      >
    </div>
  </div>
  {
    !isHome && entry.data.description && (
      <p class="document-description">{entry.data.description}</p>
    )
  }
</header>
{
  supportCopy && (
    <aside class="support-status" data-support={support}>
      {supportCopy}
    </aside>
  )
}
{
  entry.data.translation.status !== "complete" && (
    <aside class="translation-notice">
      {zh
        ? "此翻译正在更新，请同时参考英文原文。"
        : "This translation is under review."}
    </aside>
  )
}
