---
import PageTitle from "@astrojs/starlight/components/PageTitle.astro";
import IconButton from "./IconButton.astro";
import {
  canonicalPage,
  getPortal,
  PORTALS,
  portalDestinations,
} from "../lib/navigation";
const { entry, locale } = Astro.locals.starlightRoute;
const zh = locale === "zh-cn";
const id = entry.id.replace(/\/?index$/, "") || "index";
const portal = getPortal(entry.id);
const destination = portalDestinations(locale).find(
  (item) => item.id === portal,
)!;
const group = PORTALS[portal].groups.find((item) =>
  item.pages.includes(canonicalPage(entry.id)),
);
const eyebrow = group ? (zh ? group.zh : group.label) : destination.description;
const isLanding = canonicalPage(entry.id) === PORTALS[portal].landing;
---

<header class="document-heading">
  <p class="document-eyebrow">
    <a href={destination.href}>{destination.label}</a><span aria-hidden="true">
      /
    </span>{eyebrow}
  </p>
  <div class="document-title">
    <PageTitle />
    <div class="document-actions" data-pagefind-ignore>
      <IconButton href={`/${id}.md`} label="查看 Markdown 原文"
        ><svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
          ><path d="M7 3h7l4 4v14H7zM14 3v5h4M10 12h5M10 16h5"></path></svg
        ></IconButton
      >
    </div>
  </div>
  {
    !isLanding && entry.data.description && (
      <p class="document-description">{entry.data.description}</p>
    )
  }
</header>
{
  entry.data.translation.status !== "complete" && (
    <aside class="translation-notice">
      {zh
        ? "此翻译正在更新，请同时参考英文原文。"
        : "This translation is under review."}
    </aside>
  )
}
